# ==============================================================================
# ตัวอย่างไฟล์ตั้งค่า — คัดลอกเป็น .env แล้วเติมค่าจริง:  cp .env.example .env
#
# ห้าม commit .env ที่มีค่าจริงขึ้น git (มี secret ของ DB / JWT / Cloudinary / SMTP)
# docker compose จะอ่านไฟล์ .env นี้อัตโนมัติเวลา build/up
# ==============================================================================


# ------------------------------------------------------------------------------
# Database (จำเป็น) — connection string ของ PostgreSQL
# ถ้าเซิร์ฟเวอร์ไม่ตั้งค่านี้ backend จะไม่ยอมสตาร์ท
# ------------------------------------------------------------------------------
# ตัวอย่าง Neon (cloud, มี TLS):
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# ตัวอย่าง postgres local (เปิด profile local-db ใน docker compose):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/koyama?sslmode=disable


# ------------------------------------------------------------------------------
# Auth (จำเป็น) — secret สำหรับเซ็น JWT
# ต้องเป็นค่าสุ่มยาว ๆ (>= 32 ตัวอักษร) และเก็บเป็นความลับ
# สร้างค่าใหม่ได้ด้วย:  openssl rand -base64 48
# หมายเหตุ: เปลี่ยนค่านี้ = token เดิมใช้ไม่ได้ ทุกคนต้อง login ใหม่
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret


# ------------------------------------------------------------------------------
# CORS — โดเมน frontend ที่อนุญาตให้เรียก API (คั่นหลายอันด้วยจุลภาค ไม่มีช่องว่าง)
# dev: http://localhost:3000   |   prod: ใส่โดเมนจริง
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000
# prod ตัวอย่าง: ALLOWED_ORIGINS=https://academy.example.com,https://admin.example.com


# ------------------------------------------------------------------------------
# Frontend → Backend (build-time!) — URL ของ API ต้องลงท้ายด้วย /api
# ถูกฝังลง bundle ตอน `docker compose build` — แก้แล้วต้อง build frontend ใหม่
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# prod ตัวอย่าง: NEXT_PUBLIC_API_URL=https://api.example.com/api


# ------------------------------------------------------------------------------
# Cloudinary (จำเป็นถ้าใช้อัปโหลดรูป/สลิป) — เก็บไฟล์รูปภาพ
# หาได้จาก Dashboard ของ Cloudinary (รูปแบบ cloudinary://<key>:<secret>@<cloud_name>)
# ------------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=your_folder_name


# ------------------------------------------------------------------------------
# face-service — Python service ที่แปลงรูปใบหน้าเป็น embedding
#
# ⚠️ ห้ามผูกโดเมนสาธารณะให้ service นี้ ต้องเรียกผ่าน network ภายในเท่านั้น
# (docker compose: http://face-service:8080 · Railway: http://<ชื่อ>.railway.internal:8080)
#
# FACE_SERVICE_SECRET ต้องตรงกันทั้งฝั่ง Go และฝั่ง Python
# สร้างค่าสุ่มด้วย:  openssl rand -hex 32
# ------------------------------------------------------------------------------
FACE_SERVICE_URL=http://face-service:8080
FACE_SERVICE_SECRET=


# ------------------------------------------------------------------------------
# SlipOK (จำเป็นถ้าใช้ตรวจสลิปโอนเงินอัตโนมัติ) — บริการตรวจสลิปธนาคารไทย
# ------------------------------------------------------------------------------
SLIPOK_API_KEY=your_slipok_api_key
SLIPOK_BRANCH_ID=your_slipok_branch_id


# ------------------------------------------------------------------------------
# SMTP / Email (จำเป็นถ้าใช้ส่งอีเมล เช่น OTP รีเซ็ตรหัสผ่าน)
# กรณี Gmail: SMTP_PASSWORD ต้องเป็น "App Password" ไม่ใช่รหัสผ่านบัญชีปกติ
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=Koyama Badminton <your@gmail.com>


# ------------------------------------------------------------------------------
# Server (ไม่บังคับ) — พอร์ตที่ backend ฟัง (ดีฟอลต์ 8000)
# ------------------------------------------------------------------------------
# PORT=8000
